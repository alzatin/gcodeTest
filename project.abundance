              "name": "movingSel",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ],
          "interpreterVersion": 1,
          "code": "// Match two faces: keep the Static shape put and move the Moving shape so its\n// clicked face sits flush against the Static shape's clicked face.\nfunction run(staticSel: Assembly, movingSel: Assembly) {\n  if (!staticSel || !movingSel) {\n    throw new Error(\"Connect a 3D shape to both Static and Moving.\");\n  }\n\n  function pick(a: Assembly, label: string) {\n    let picked = null;\n    a.onLeafs((leaf) => {\n      if (picked && picked.face) return leaf;\n      const g = leaf.geometry;\n      if (g instanceof replicad.Drawing) {\n        throw new Error(label + \" must be a 3D shape, not a 2D drawing.\");\n      }\n      const idxs = (leaf.selection && leaf.selection.faces) || [];\n      if (idxs.length > 0) {\n        picked = { leaf: leaf, geom: g, face: g.faces[idxs[0]] };\n      } else if (!picked) {\n        picked = { leaf: leaf, geom: g, face: null };\n      }\n      return leaf;\n    });\n    return picked;\n  }\n\n  const s = pick(staticSel, \"Static\");\n  const m = pick(movingSel, \"Moving\");\n  if (!s || !m) {\n    throw new Error(\"Connect a 3D shape to both Static and Moving.\");\n  }\n\n  const staticOut = new Assembly({ ...s.leaf, geometry: s.geom, selection: undefined });\n\n  // Nothing clicked yet on one side: leave both shapes where they are.\n  if (!s.face || !m.face) {\n    const passThrough = new Assembly({ ...m.leaf, geometry: m.geom, selection: undefined });\n    return new Assembly({ geometry: [staticOut, passThrough] });\n  }\n\n  const Cs = s.face.center;\n  const Cm = m.face.center;\n  const Ns = s.face.normalAt(Cs.toTuple()).normalized();\n  const Nm = m.face.normalAt(Cm.toTuple()).normalized();\n\n  // The moving face should end up pointing opposite the static face.\n  const targetDir = Ns.multiply(-1);\n\n  let dot = Nm.dot(targetDir);\n  dot = Math.max(-1, Math.min(1, dot));\n  const angleDeg = (Math.acos(dot) * 180) / Math.PI;\n\n  const cross = Nm.cross(targetDir);\n  let axisTuple;\n  if (cross.Length < 1e-9) {\n    // Normals already (anti)parallel; for a 180 flip pick any perpendicular axis.\n    let perp = Nm.cross(new replicad.Vector([1, 0, 0]));\n    if (perp.Length < 1e-9) perp = Nm.cross(new replicad.Vector([0, 1, 0]));\n    axisTuple = perp.normalized().toTuple();\n  } else {\n    axisTuple = cross.normalized().toTuple();\n  }\n\n  const cm = Cm.toTuple();\n  const cs = Cs.toTuple();\n\n  // Rotate about the moving face centre (keeps it in place), then slide that\n  // centre onto the static face centre so the faces are flush and aligned.\n  const moved = m.geom\n    .clone()\n    .rotate(angleDeg, cm, axisTuple)\n    .translate([cs[0] - cm[0], cs[1] - cm[1], cs[2] - cm[2]]);\n\n  const movingOut = new Assembly({ ...m.leaf, geometry: moved, selection: undefined });\n  return new Assembly({ geometry: [staticOut, movingOut] });\n}\n",
          "compiledCode": "\"use strict\";\n// Match two faces: keep the Static shape put and move the Moving shape so its\n// clicked face sits flush against the Static shape's clicked face.\nfunction run(staticSel, movingSel) {\n    if (!staticSel || !movingSel) {\n        throw new Error(\"Connect a 3D shape to both Static and Moving.\");\n    }\n    function pick(a, label) {\n        let picked = null;\n        a.onLeafs((leaf) => {\n            if (picked && picked.face)\n                return leaf;\n            const g = leaf.geometry;\n            if (g instanceof replicad.Drawing) {\n                throw new Error(label + \" must be a 3D shape, not a 2D drawing.\");\n            }\n            const idxs = (leaf.selection && leaf.selection.faces) || [];\n            if (idxs.length > 0) {\n                picked = { leaf: leaf, geom: g, face: g.faces[idxs[0]] };\n            }\n            else if (!picked) {\n                picked = { leaf: leaf, geom: g, face: null };\n            }\n            return leaf;\n        });\n        return picked;\n    }\n    const s = pick(staticSel, \"Static\");\n    const m = pick(movingSel, \"Moving\");\n    if (!s || !m) {\n        throw new Error(\"Connect a 3D shape to both Static and Moving.\");\n    }\n    const staticOut = new Assembly({ ...s.leaf, geometry: s.geom, selection: undefined });\n    // Nothing clicked yet on one side: leave both shapes where they are.\n    if (!s.face || !m.face) {\n        const passThrough = new Assembly({ ...m.leaf, geometry: m.geom, selection: undefined });\n        return new Assembly({ geometry: [staticOut, passThrough] });\n    }\n    const Cs = s.face.center;\n    const Cm = m.face.center;\n    const Ns = s.face.normalAt(Cs.toTuple()).normalized();\n    const Nm = m.face.normalAt(Cm.toTuple()).normalized();\n    // The moving face should end up pointing opposite the static face.\n    const targetDir = Ns.multiply(-1);\n    let dot = Nm.dot(targetDir);\n    dot = Math.max(-1, Math.min(1, dot));\n    const angleDeg = (Math.acos(dot) * 180) / Math.PI;\n    const cross = Nm.cross(targetDir);\n    let axisTuple;\n    if (cross.Length < 1e-9) {\n        // Normals already (anti)parallel; for a 180 flip pick any perpendicular axis.\n        let perp = Nm.cross(new replicad.Vector([1, 0, 0]));\n        if (perp.Length < 1e-9)\n            perp = Nm.cross(new replicad.Vector([0, 1, 0]));\n        axisTuple = perp.normalized().toTuple();\n    }\n    else {\n        axisTuple = cross.normalized().toTuple();\n    }\n    const cm = Cm.toTuple();\n    const cs = Cs.toTuple();\n    // Rotate about the moving face centre (keeps it in place), then slide that\n    // centre onto the static face centre so the faces are flush and aligned.\n    const moved = m.geom\n        .clone()\n        .rotate(angleDeg, cm, axisTuple)\n        .translate([cs[0] - cm[0], cs[1] - cm[1], cs[2] - cm[2]]);\n    const movingOut = new Assembly({ ...m.leaf, geometry: moved, selection: undefined });\n    return new Assembly({ geometry: [staticOut, movingOut] });\n}\n"
        }
